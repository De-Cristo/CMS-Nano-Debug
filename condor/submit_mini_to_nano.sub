# ==============================================================================
# submit_mini_to_nano.sub
# ==============================================================================
# HTCondor submit description for parallel MiniAOD -> NanoAOD production
# ==============================================================================

Universe              = vanilla
Executable            = condor/condor_mini_to_nano_wrapper.sh
Proxy_filename        = x509up

# Arguments: Proxy Cluster Process InputFile EosDir ApplyPatch Events
arguments             = $(Proxy_filename) $(Cluster) $(Process) $(InputFile) $(EosDir) $(ApplyPatch) $(Events)

should_transfer_files = YES
transfer_input_files  = condor/$(Proxy_filename),scripts,patches

when_to_transfer_output = ON_EXIT
transfer_output_files = ""

request_cpus          = 4
request_memory        = 4000
+JobFlavour           = "workday"
+MaxRuntime           = 28800

Output                = logs/mini2nano_$(Cluster)_$(Process).out
Error                 = logs/mini2nano_$(Cluster)_$(Process).err
Log                   = logs/mini2nano_$(Cluster).log

# Default parameters (can be overridden from command line via -append)
ApplyPatch            = 1
Events                = 500
EosDir                = /eos/user/l/lichengz/WH_NanoAODv15_Patched/

# Example queue definition (user can supply a file with input LFNs)
# InputFile           = root://cms-xrd-global.cern.ch///store/mc/...
# queue 10
